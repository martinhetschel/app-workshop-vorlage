rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jede angemeldete Person hat ihren eigenen Bereich: users/<ihre-uid>/...
    // Alles, was unter ihrer uid liegt, darf nur sie selbst lesen und schreiben.
    // Neue Sammlungen für die eigene App kommen deshalb immer dorthin hinein,
    // zum Beispiel users/<uid>/aufgaben. Dafür sind keine neuen Regeln nötig.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Alles andere bleibt gesperrt
  }
}
